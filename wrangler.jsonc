// langlab.uk: the static pages in site/ served by Cloudflare (Workers static assets), the domain attached on deploy;
// src/worker.js takes the access form and hands out the app from R2 at /download (secrets: INTAKE_KEY, TURNSTILE_SECRET via `wrangler secret put`;
// requests go to the server at API_URL, the admin reads them there).
//   npx wrangler@4 deploy
{
  "name": "langlab-landing",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": { "binding": "ASSETS", "directory": "./site", "not_found_handling": "404-page", "html_handling": "drop-trailing-slash",
              // the worker's own paths: else a browser's navigation to them gets the 404 page before the worker runs
              "run_worker_first": ["/download", "/api/*"] },
  "vars": { "API_URL": "https://api.langlab.uk" },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "langlab-downloads" }],
  "routes": [{ "pattern": "langlab.uk", "custom_domain": true }]
}
